# ==========================================
# statsFM - Environment Variables
# ==========================================

# Last.fm API Key (Optional):
# Obtain a free key at: https://www.last.fm/api/account/create
# If omitted, the application uses an active fallback key automatically.
LASTFM_API_KEY=""
VITE_LASTFM_API_KEY=""

# Application Port (Used by Express server entrypoint server.ts)
PORT=3000

# Base URL (Optional, for self-referential links / share card generation)
# Live domain: https://paidguy.me/statsfm
APP_URL="https://paidguy.me/statsfm"
